# 依赖
node_modules/

# 构建产物（部署时手动上传，不入库，避免把构建时注入的环境变量带进仓库）
dist/
web/dist/

# 环境变量与密钥
.env
.env.*
!.env.example

# 日志与杂项
*.log
coverage/
.DS_Store
Thumbs.db

# skill 快照中的缓存与备份
*.bak-*

# 本地治理测试数据
backend/skill-proposals.json

# 第三方工具仓库（ws-scrcpy 为外部 clone，体积大不入库）
tools/
# 完整排除：按用户要求不上传（已在远端的部分保留历史，此后不再跟踪）
android/
migration-runs/
# Android 构建产物（已由上方整目录排除，此处保留以防粒度恢复）
android/*/app/build/
android/*/.gradle/
android/*/build/
android/*/local.properties
# 运行时镜像文件
backend/.mirror-*.json
# 模拟器/系统临时文件
*.log
.DS_Store
config.json
