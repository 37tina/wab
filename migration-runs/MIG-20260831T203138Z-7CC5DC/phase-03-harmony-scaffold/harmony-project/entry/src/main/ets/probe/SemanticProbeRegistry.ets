// SemanticProbeRegistry - Phase 4 wiring registry (NOT hash-frozen;
// implementation agents register real Repository/Preferences/
// RelationalStore providers from their own source files).
// Generated by init_scaffold (batch 2 #85); keys set is frozen.
export type ProbeProvider = () => object | null;

interface Entry {
  key: string;
  provider: ProbeProvider;
}

export const PROBE_KEYS: string[] = ['account_id', 'accounts_dir', 'api_url', 'app_theme', 'article_filter', 'article_list_sort_order', 'article_statuses', 'articles', 'articles__accountid_db', 'feeds', 'last_refreshed_at', 'password', 'settings', 'source', 'theme_mode', 'username'];

const entries: Entry[] = [];

export function registerProbe(key: string, provider: ProbeProvider): void {
  for (let i = 0; i < entries.length; i++) {
    if (entries[i].key === key) {
      entries[i].provider = provider;
      return;
    }
  }
  entries.push({ key: key, provider: provider });
}

export function collectProbeSnapshot(): Record<string, object | null> {
  const out: Record<string, object | null> = {};
  for (const key of PROBE_KEYS) {
    let hit = false;
    for (const entry of entries) {
      if (entry.key === key) {
        hit = true;
        try {
          out[key] = entry.provider();
        } catch (e) {
          out[key] = null;
        }
        break;
      }
    }
    if (!hit) {
      out[key] = null;
    }
  }
  return out;
}
