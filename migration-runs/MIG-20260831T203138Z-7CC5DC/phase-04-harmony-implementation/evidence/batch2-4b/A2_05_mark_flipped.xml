="false" bounds="[44,858][1036,1284]" drawing-order="0" hint=""><node index="0" text="Bentley provided flights from Washington, DC, to Monterey, California, and accommodation so Ars could drive the Supersports, as well as ride in a preproduction Torcal EV, " resource-id="" class="android.widget.TextView" package="com.capyreader.app.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,869][995,1133]" drawing-order="0" hint="" /><node index="1" text="" resource-id="" class="android.view.View" package="com.capyreader.app.debug" content-desc="which we wrote about" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[525,1078][957,1133]" drawing-order="0" hint=""><node index="0" text="which we wrote about" resource-id="" class="android.widget.TextView" package="com.capyreader.app.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[525,1078][957,1133]" drawing-order="0" hint="" /></node><node index="2" text=" last week. Ars does not accept paid editorial content." resource-id="" class="android.widget.TextView" package="com.capyreader.app.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1149][907,1276]" drawing-order="0" hint="" /></node><node index="1" text="" resource-id="" class="android.view.View" package="com.capyreader.app.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1325][1036,2032]" drawing-order="0" hint=""><node index="0" text="MONTEREY, Calif.—Last week, we " resource-id="" class="android.widget.TextView" package="com.capyreader.app.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1333][709,1388]" drawing-order="0" hint="" /><node index="1" text="" resource-id="" class="android.view.View" package="com.capyreader.app.debug" content-desc="brought news" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[706,1333][976,1388]" drawing-order="0" hint=""><node index="0" text="brought news" resource-id="" class="android.widget.TextView" package="com.capyreader.app.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[706,1333][976,1388]" drawing-order="0" hint="" /></node><node index="2" text=" of the Bentley Torcal, a new electric vehicle that the luxury automaker has been cooking up at its HQ in Crewe, England. The company wants to attract new customers with its first battery EV, part of a plan to make sustainability as much a part of the brand's character as its high-end fit and finish. W12 engines have given way to V8 plug-in hybrid power, and the new Continental GT is " resource-id="" class="android.widget.TextView" package="com.capyreader.app.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1333][1028,1952]" drawing-order="0" hint="" /><node index="3" text="" resource-id="" class="android.view.View" package="com.capyreader.app.debug" content-desc="all the better for it" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1897][1023,2024]" drawing-order="0" hint=""><node index="0" text="all the better for it" resource-id="" class="android.widget.TextView" package="com.capyreader.app.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1897][1023,2024]" drawing-order="0" hint="" /></node><node index="4" text="." resource-id="" class="android.widget.TextView" package="com.capyreader.app.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[134,1969][148,2024]" drawing-order="0" hint="" /></node><node index="2" text="" resource-id="" class="android.view.View" package="com.capyreader.app.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,2073][1036,2400]" drawing-order="0" hint=""><node index="0" text="But around the same time as Ars " resource-id="" class="android.widget.TextView" package="com.capyreader.app.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,2081][695,2136]" drawing-order="0" hint="" /><node index="1" text="" resource-id="" class="android.view.View" package="com.capyreader.app.debug" content-desc="got its first experience" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,2081][907,2208]" drawing-order="0" hint=""><node index="0" text="got its first experience" resource-id="" class="android.widget.TextView" package="com.capyreader.app.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,2081][907,2208]" drawing-order="0" hint="" /></node><node index="2" text=" of that new PHEV two-door on a rather wet Spanish racetrack, some of Bentley's boffins were wondering what might happen if you also built one without the hybrid stuff." resource-id="" class="android.widget.TextView" package="com.capyreader.app.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,2150][1020,2400]" drawing-order="0" hint="" /></node><node index="3" text="Or all-wheel drive—something that has been a characteristic of every new road-going Bentley since the turn of the century. That would certainly cut the curb weight. So, too, would leaving out the rear seats. That sort of idea leads down a well-trodden path for some OEMs, and Porsche in particular is famous for making stripped-out road cars inspired by its race cars and making money from them, too." resource-id="" class="android.widget.TextView" package="com.capyreader.app.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="4" text="" resource-id="" class="android.view.View" package="com.capyreader.app.debug" content-desc="" checkable="false" c